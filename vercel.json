{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "modula-website-ten.vercel.app" }],
      "destination": "https://ismodula.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
